# Tutorial build artifacts and the files written by the tutorial notebooks (figures/roti, figures/gix of
# activity_indexes.ipynb and output/kriging of kriging.ipynb are regenerated on every run)
tutorial/_build/
tutorial/ionosphere/figures/
tutorial/ionosphere/output/

# Sample STEC results of the examples (sample_data/output/, matched by output/ and *.parquet.gzip above): the four
# tracked files stay tracked by name, anything else written there stays local
!/sample_data/output/
/sample_data/output/*
!/sample_data/output/BOR1_E_STEC.parquet.gzip
!/sample_data/output/BOR1_G_STEC.parquet.gzip
!/sample_data/output/BRUX_E_STEC.parquet.gzip
!/sample_data/output/BRUX_G_STEC.parquet.gzip

# STEC network of 2024-035 read by the ionosphere tutorials activity_indexes.ipynb and kriging.ipynb (matched by
# *.parquet.gzip above): tracked and published, anything else in that folder stays local
!/tutorial/ionosphere/network/*_STEC.parquet.gzip
